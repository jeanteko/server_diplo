{
	auto_https off # eigenes serverzertifikat statt lets encrypt
	admin off #verwaltung aus
}

# dashboard
:443 {
	tls /etc/caddy/server.crt /etc/caddy/server.key
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		-Server # servername nicht zeigen
	}
	reverse_proxy grafana:3000
}

# geraete
:8443 {
	tls /etc/caddy/server.crt /etc/caddy/server.key {
		client_auth {
			mode require_and_verify # zertifikat vom geraet muss sein
			trusted_ca_cert_file /etc/caddy/ca.crt #von eigener ca
		}
	}
	header {
		-Server
	}
	reverse_proxy ingest:3000 {
		header_up X-Client-Subject {http.request.tls.client.subject} # zertifikat angaben an schnittstelle
	}
}
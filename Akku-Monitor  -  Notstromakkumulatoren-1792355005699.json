      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.geraet_id AS \"Gerät\", g.standort AS \"Standort\", g.akku_typ AS \"Akkutyp\", m.soh_prozent AS \"SoH %\", m.spannung_v AS \"Spannung V\", m.temperatur_c AS \"Temp °C\", m.zeit AS \"Letzte Messung\" FROM geraete g LEFT JOIN LATERAL (  SELECT * FROM messwerte w WHERE w.geraet_id = g.geraet_id   ORDER BY zeit DESC LIMIT 1) m ON TRUE WHERE g.aktiv ORDER BY m.soh_prozent NULLS FIRST",
          "refId": "A"
        }
      ],
      "title": "Alle Geräte  -  Übersicht",
